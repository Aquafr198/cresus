# Offivex Docker Configuration
# Copy this file to .env and fill in your values
# Then run: docker compose up -d

# ── Domain ────────────────────────────────────────────────────────────────────
# Your domain name. Caddy will auto-provision TLS via Let's Encrypt.
# Use "localhost" for local development (self-signed cert).
DOMAIN=localhost

# ── Solana ────────────────────────────────────────────────────────────────────
# "devnet" or "mainnet"
OFFIVEX_SOLANA_CLUSTER=devnet

# RPC endpoints (use paid RPCs for production)
SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com
SOLANA_RPC_DEVNET=https://api.devnet.solana.com

# ── API Keys (optional) ──────────────────────────────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_KEY=
BIRDEYE_API_KEY=

# ── Jito (optional) ──────────────────────────────────────────────────────────
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=10000

# ── Trading ───────────────────────────────────────────────────────────────────
OFFIVEX_PRIORITY_FEE_MICRO_LAMPORTS=50000

# ── Treasury wallet (REQUIRED — boot fail-fast if missing or invalid) ────────
# BIP39 12 or 24 words. Derives invoice addresses via HD path m/44'/501'/N'/0'.
# PROD: load from a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# Do NOT commit a real seed to git. Replace __SET_ME__ with your actual phrase
# at deploy time via `--env` flag or out-of-band secret injection.
# Generate a fresh BIP39 phrase: https://iancoleman.io/bip39/ (offline tab)
OFFIVEX_TREASURY_SEED_PHRASE=__SET_ME__

# ── CORS (REQUIRED on mainnet — boot fail-fast if empty/wildcard/http://) ────
# Comma-separated allowlist of frontend origins. On mainnet, only HTTPS
# production domains are accepted; localhost/wildcard/http:// rejected at boot.
# Devnet/localhost: defaults to http://localhost:3000,http://127.0.0.1:3000 if unset.
OFFIVEX_CORS_ORIGINS=https://offivex.io,https://app.offivex.io

# ── Advanced ──────────────────────────────────────────────────────────────────
OFFIVEX_LOG_LEVEL=info
DEV_MODE=false
