# Offivex Backend Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains secrets!

# =============================================================================
# Server Configuration
# =============================================================================
OFFIVEX_HOST=127.0.0.1
OFFIVEX_PORT=3001
OFFIVEX_DB_PATH=data/offivex.db

# Logging level: trace, debug, info, warn, error
OFFIVEX_LOG_LEVEL=info

# Solana cluster: "devnet" or "mainnet" (default: devnet for safety)
# IMPORTANT: Set to "mainnet" only when you are ready for production!
OFFIVEX_SOLANA_CLUSTER=devnet

# =============================================================================
# Solana RPC Endpoints
# =============================================================================
# You need at least one RPC endpoint. For production, use paid RPC providers
# for better rate limits and reliability.
#
# Free options (with limits):
# - https://api.mainnet-beta.solana.com (public, rate limited)
# - https://api.devnet.solana.com (devnet)
#
# Paid options (recommended for production):
# - QuickNode: https://www.quicknode.com/
# - Helius: https://helius.xyz/
# - Alchemy: https://www.alchemy.com/
# - Triton: https://triton.one/

# Mainnet RPC (comma-separated for failover)
SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com

# Devnet RPC (for testing)
SOLANA_RPC_DEVNET=https://api.devnet.solana.com

# =============================================================================
# IPFS / Pinata Configuration
# =============================================================================
# Used for token metadata and meme library assets
# Get API keys from: https://app.pinata.cloud/
#
# Optional: If not provided, assets stored locally only (not recommended)

PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_api_key_here

# =============================================================================
# Price Feed APIs (for Bumper Bot)
# =============================================================================
# Jupiter Price API: Free, no key required (built-in)
#
# Birdeye: More reliable for new/obscure tokens
# Get API key from: https://birdeye.so/
# Optional: If not provided, only Jupiter price API used

BIRDEYE_API_KEY=your_birdeye_api_key_here

# =============================================================================
# Jito Configuration (for Bundle Tips)
# =============================================================================
# Jito block engine for MEV protection and bundle submission
# Optional: If not provided, bundles submitted via regular RPC

JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Placeholder — backend rotates over the 8 official Jito tip accounts
# automatically (see crates/offivex-core/src/bundle/jito.rs). You only
# need to override this if you want to pin to one specific tip account.
JITO_TIP_ACCOUNT=11111111111111111111111111111111

# Jito tip amount in lamports (default: 10000 = 0.00001 SOL)
JITO_TIP_LAMPORTS=10000

# =============================================================================
# Security Settings
# =============================================================================
# Allowed CORS origins (comma-separated)
# In production, restrict this to your frontend domain only
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session timeout in seconds (default: 3600 = 1 hour)
SESSION_TIMEOUT_SECONDS=3600

# Max password attempts before lockout
MAX_PASSWORD_ATTEMPTS=5

# =============================================================================
# Rate Limiting
# =============================================================================
# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=100

# Auth endpoint rate limit (stricter)
AUTH_RATE_LIMIT_PER_MINUTE=5

# =============================================================================
# Trading Bot Configuration
# =============================================================================
# Default slippage in basis points (500 = 5%)
DEFAULT_SLIPPAGE_BPS=500

# Priority fee in micro lamports for transaction priority (default: 50000)
# Higher values = faster inclusion during congestion. 1 lamport = 1,000,000 micro lamports.
# Set to 0 to disable priority fees.
OFFIVEX_PRIORITY_FEE_MICRO_LAMPORTS=50000

# Max retries for failed swaps
MAX_SWAP_RETRIES=3

# Retry delay in seconds
SWAP_RETRY_DELAY_SECONDS=5

# =============================================================================
# Backup Configuration
# =============================================================================
# Directory for database backups (relative to backend/)
BACKUP_DIR=data/backups

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Off-site backup upload command (optional)
# {file} is replaced with the local backup file path after each backup.
# Examples:
#   OFFIVEX_BACKUP_UPLOAD_CMD=aws s3 cp {file} s3://my-bucket/Offivex-backups/
#   OFFIVEX_BACKUP_UPLOAD_CMD=rclone copy {file} remote:Offivex-backups/
# OFFIVEX_BACKUP_UPLOAD_CMD=

# =============================================================================
# Advanced Configuration (usually don't need to change)
# =============================================================================
# Database connection pool size
DB_POOL_SIZE=10

# RPC connection timeout in seconds
RPC_TIMEOUT_SECONDS=30

# Enable development mode (disables some security checks)
# NEVER set to true in production!
DEV_MODE=false
