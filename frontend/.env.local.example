# Offivex frontend — environment variables example
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by Next.js — never commit secrets.

# Backend API URL (Rust server)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api/v1

# Telegram bot for /apply form notifications
# 1. Create a bot via @BotFather on Telegram
# 2. Send /start to your bot
# 3. Get your chat_id:
#      curl "https://api.telegram.org/bot<TOKEN>/getUpdates" | jq '.result[-1].message.chat.id'
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
