# Offivex Production Reverse Proxy
# Caddy automatically provisions and renews TLS certificates via Let's Encrypt.
#
# Usage:
#   1. Install Caddy: https://caddyserver.com/docs/install
#   2. Replace "offivex.yourdomain.com" with your actual domain
#   3. Run: caddy run --config Caddyfile
#
# For local development with self-signed cert:
#   caddy run --config Caddyfile --adapter caddyfile
#
# NOTE — header definitions live in `docker/caddy-snippets.conf` so the
# docker-compose deployment and this manual config never drift.

import docker/caddy-snippets.conf

offivex.yourdomain.com {
	# TLS is automatic — Caddy handles Let's Encrypt certificates

	import security_headers

	# Frontend (Next.js on port 3000)
	handle {
		reverse_proxy localhost:3000
	}

	# Backend API
	handle /api/* {
		reverse_proxy localhost:3001
	}

	# WebSocket for monitor
	handle /ws/* {
		reverse_proxy localhost:3001
	}

	# Rate limit at the edge — 60 requests per minute per IP
	# (backend has its own finer-grained limits too)
	rate_limit {
		zone global {
			key {remote_host}
			events 60
			window 1m
		}
	}

	# Access log
	log {
		output file /var/log/caddy/offivex-access.log {
			roll_size 50mb
			roll_keep 10
		}
	}
}
