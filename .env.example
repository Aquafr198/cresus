# Offivex Server Configuration — copy to `.env` (git-ignored) and edit.
# Required vars are marked REQUIRED; the rest have sensible defaults.

# ── Network ──────────────────────────────────────────────────────────────────
OFFIVEX_HOST=127.0.0.1
OFFIVEX_PORT=3001
OFFIVEX_DB_PATH=data/offivex.db
OFFIVEX_LOG_LEVEL=info

# ── Solana ───────────────────────────────────────────────────────────────────
# `devnet` for local testing, `mainnet` only when you're ready for real money.
OFFIVEX_SOLANA_CLUSTER=devnet
SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com
SOLANA_RPC_DEVNET=https://api.devnet.solana.com

# ── CORS (REQUIRED on mainnet — boot fails fast if empty / wildcard / http) ──
# Comma-separated allowlist of frontend origins. On mainnet only HTTPS
# production domains are accepted. Devnet/localhost: defaults to
# http://localhost:3000,http://127.0.0.1:3000 if unset.
OFFIVEX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Treasury seed (REQUIRED — backend panics at boot if missing/invalid) ─────
# BIP39 12 or 24 words. Derives invoice addresses (HD path m/44'/501'/N'/0').
# Generate offline at https://iancoleman.io/bip39/ (Offline tab).
# Replace `__SET_ME__` before first run.
OFFIVEX_TREASURY_SEED_PHRASE=__SET_ME__

# ── Optional: SOL/USD price fallback ─────────────────────────────────────────
# If CoinGecko is unreachable AND the in-memory cache has no last-known
# price, fall back to this admin-provided rate (in USD per 1 SOL) instead
# of failing every invoice. Leave unset to fail invoices instead.
# OFFIVEX_FALLBACK_SOL_USD=175.0

# ── Optional: PNL bot integration ────────────────────────────────────────────
# Bearer token shared with the Discord bot for /api/v1/pnl/* endpoints.
# Generate with: openssl rand -hex 32
# Leave unset to disable the /pnl/* routes entirely (zero attack surface).
# OFFIVEX_BOT_PNL_TOKEN=

# ── Optional: Telegram apply notifications ───────────────────────────────────
# OFFIVEX_TELEGRAM_BOT_TOKEN=
# OFFIVEX_TELEGRAM_CHAT_ID=
# OFFIVEX_TELEGRAM_LAUNCH_CHANNEL_ID=

# ── Pinata IPFS (token metadata) ─────────────────────────────────────────────
# Get from https://app.pinata.cloud/ — JWT preferred over key/secret pair.
# PINATA_JWT=

# ── Frontend (Next.js build-time) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api/v1
