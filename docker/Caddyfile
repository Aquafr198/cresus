# Offivex Docker Reverse Proxy
# Replace {$DOMAIN} with your domain via DOMAIN env var in docker-compose.yml
#
# For local development: set DOMAIN=localhost in .env
# For production: set DOMAIN=offivex.yourdomain.com

import caddy-snippets.conf

{$DOMAIN:localhost} {
	import security_headers

	# Backend API (matched first — more specific)
	handle /api/* {
		reverse_proxy backend:3001
	}

	# WebSocket for monitor
	handle /ws/* {
		reverse_proxy backend:3001
	}

	# Frontend (Next.js — fallback for everything else)
	handle {
		reverse_proxy frontend:3000
	}

	# Access log
	log {
		output stdout
	}
}
