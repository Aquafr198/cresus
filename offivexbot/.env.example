# Offivex Discord bot — environment variables
#
# Copy this file to `.env` and fill the values. Anything left blank falls
# back to the defaults in config.json (which target the local dev backend
# at http://localhost:3001/api/v1).

# ── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications/<APP_ID>/bot
TOKEN=
# OAuth Client ID (= the application id). Needed by deploy-commands.js
# when registering slash commands.
CLIENT_ID=
# Guild id used by deploy-commands.js to register slash commands instantly
# for testing. Leave empty in prod to register globally (1-hour cache delay).
GUILD_ID=

# ── Operator owners ────────────────────────────────────────────────────────
# Comma-separated list of Discord user IDs allowed to /restartbot. Replaces
# the previously-hardcoded OWNER_IDS array in src/commands/admin/restartbot.js.
# Example: OWNER_IDS=1310093128845365331,123456789012345678
OWNER_IDS=

# ── Offivex backend integration ────────────────────────────────────────────
# Bearer token shared with the Rust backend (OFFIVEX_BOT_PNL_TOKEN there,
# PNL_API_TOKEN here). Without it the PNL poller silently no-ops.
PNL_API_TOKEN=
# Discord channel id where PNL cards land. Without it the poller no-ops.
PNL_CHANNEL_ID=
# Optional: override the Rust backend base URL. Defaults to
# http://localhost:3001/api/v1. Use https://api.offivex.gg/api/v1 in prod.
API_BASE_URL=
# Optional: override the brand site URL embedded in PNL cards (default
# https://offivex.gg).
SITE_URL=
# Optional: override the PNL poll interval in milliseconds (default 30000).
PNL_POLL_INTERVAL_MS=

# ── SQLite ─────────────────────────────────────────────────────────────────
# Optional: relocate the SQLite file. Default is ./data/bot.db next to
# the repo. Useful when running under PM2 with a managed data directory.
BOT_DB_PATH=
